# ── SMTP ──────────────────────────────────────────────────────────────────────
# Leave blank to disable email sending (upload links will still appear in the UI).
#
# Development — Mailpit (catches all emails locally, no actual sending):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   UI: http://localhost:8025
#
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
#
# Production — Resend (recommended, generous free tier):
#   https://resend.com → API Keys → create key → use as password
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_STARTTLS=false
#
# Other providers (Gmail, Outlook, Mailgun…):
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Anonymizator <noreply@your-domain.com>
# Use "false" for port 465 (SSL), "true" for port 587 (STARTTLS)
SMTP_STARTTLS=true

# ── Server ────────────────────────────────────────────────────────────────────
# Backend public URL — used for HTTPS redirect detection and HSTS header.
# In development: http://localhost:8000
# In production:  https://your-api-domain.com
BASE_URL=https://your-api-domain.com

# Frontend URL — used to build upload/decrypt links sent in emails.
# In development: http://localhost:3000
# In production:  https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# CORS — comma-separated list of allowed origins for browser requests to the API.
# In development: http://localhost:3000,http://127.0.0.1:5500
# In production:  https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where uploaded .enc files are stored.
# Absolute path recommended for server deployments.
# Defaults to <project_root>/uploads/ if not set.
# UPLOAD_DIR=/var/data/anonymizator/uploads

# Maximum upload size in megabytes.
MAX_FILE_SIZE_MB=2

# ── Expiration ────────────────────────────────────────────────────────────────
# How long a collector upload link stays valid before it expires.
TOKEN_EXPIRY_DAYS=7

# How long uploaded .enc files are kept before automatic deletion.
FILE_EXPIRY_DAYS=21

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# Defaults to anonymizator.db in the current working directory if not set.
DATABASE_PATH=/opt/anonymizator/data/anonymizator.db
