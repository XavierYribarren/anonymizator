# ── SMTP ──────────────────────────────────────────────────────────────────────
# Leave blank to skip email sending (links will still appear in the UI).
#
# Development — Mailpit (catches all emails locally, no real sending):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   UI: http://localhost:8025
#
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
#
# Production — Resend (recommended, generous free tier):
#   https://resend.com → API Keys → create key → use as password
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_STARTTLS=false
#
# Other providers (Gmail, Outlook, Mailgun…):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@email.com
SMTP_PASSWORD=ton_mot_de_passe_application
SMTP_FROM=Anonymizator <ton@email.com>
# Set to "false" if using port 465 (SSL), leave "true" for port 587 (STARTTLS)
SMTP_STARTTLS=true

# ── Server ────────────────────────────────────────────────────────────────────
# Public URL used to build links in emails and the UI.
# Change this when deploying on a VPS (e.g. https://anon.mylab.fr)
BASE_URL=http://localhost:8000

# Directory where uploaded .enc files are stored.
# Absolute path recommended when deploying on a server.
# If omitted, defaults to <project_root>/uploads/ (resolved from web/main.py location).
# UPLOAD_DIR=/var/data/anonymizator/uploads

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=500

# ── Expiration ────────────────────────────────────────────────────────────────
# How long a collector link stays valid before it expires
TOKEN_EXPIRY_DAYS=7

# How long uploaded .enc files are kept before automatic deletion
FILE_EXPIRY_DAYS=21

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file
DATABASE_PATH=anonymizator.db
